#!/usr/bin/env bash
# Runs before every push. main only changes by merging a pull request on GitHub.

while read -r local_ref local_sha remote_ref remote_sha; do
  case "$remote_ref" in
    refs/heads/main|refs/heads/master)
      echo "Stopped: pushing straight to ${remote_ref#refs/heads/} isn't allowed."
      echo "Push your branch (git push -u origin HEAD) and open a pull request instead."
      exit 1 ;;
  esac
done
exit 0
